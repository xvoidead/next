# Адрес FlowID (issuer). Для Android-эмулятора с FlowID на этом же компьютере:
#   adb reverse tcp:3000 tcp:3000   — тогда localhost внутри эмулятора ведёт на компьютер
EXPO_PUBLIC_FLOWID_URL=http://localhost:3000
# client_id публичного приложения в FlowID (см. README, раздел «FlowID»)
EXPO_PUBLIC_FLOWID_CLIENT_ID=
